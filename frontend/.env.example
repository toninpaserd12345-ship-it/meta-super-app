# Server-only values. Never prefix secrets with NUXT_PUBLIC_.
NUXT_API_BASE_URL=http://127.0.0.1:8080
NUXT_API_LOGIN_PATH=/auth/login
NUXT_API_ME_PATH=/auth/me
NUXT_SESSION_COOKIE_NAME=app_session
NUXT_ACCOUNT_COOKIE_NAME=active_account
NUXT_SESSION_MAX_AGE=28800

# Browser-safe value.
NUXT_PUBLIC_APP_NAME=Meta Super App
