{
  "buildPath": "code",
  "detector": {
    "extensions": [
      {
        "ext": ".vue",
        "engine": "html"
      }
    ],
    "ignoreRules": [
      "broken-image"
    ],
    "ignoreFiles": [],
    "ignoreValues": []
  },
  "hook": {
    "enabled": true,
    "limits": {
      "maxFindings": 5,
      "maxChars": 8000
    }
  }
}
