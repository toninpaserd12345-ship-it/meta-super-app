APP_ENV=development
HTTP_ADDR=:8080
STORAGE_DRIVER=memory
META_STATE_FILE=.data/meta-state.json
# Only required when STORAGE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meta_super_app?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=meta-super-app
ACCESS_TOKEN_TTL=8h
AUTO_MIGRATE=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
SEED_ACCOUNT_NAME=Demo Company
