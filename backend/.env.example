APP_ENV=development
HTTP_ADDR=:8080

# Database Configuration (memory or postgres)
STORAGE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meta_super_app?sslmode=disable
AUTO_MIGRATE=true

# Initial Admin User (Created on first start)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
SEED_ACCOUNT_NAME=Demo Company

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=meta-super-app
ACCESS_TOKEN_TTL=8h

# Cloudflare R2 Storage (S3 Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=meta-super-app-bucket
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Facebook / Meta App Integration (Required for Facebook features)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
# Configuration ID created in Meta Login for Business > WhatsApp Embedded Signup
META_WHATSAPP_CONFIG_ID=your_whatsapp_embedded_signup_configuration_id

# (Optional) Defaults provided in code if omitted
# META_REDIRECT_URI=http://localhost:8080/api/v1/meta/oauth/callback
# META_FRONTEND_REDIRECT=http://127.0.0.1:3001/api/auth/facebook/callback
# META_GRAPH_VERSION=v23.0
